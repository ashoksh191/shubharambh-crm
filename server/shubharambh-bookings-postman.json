          "name": "Get Executive Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": { "raw": "{{BASE_URL}}/api/dashboard/stats", "host": ["{{BASE_URL}}"], "path": ["api", "dashboard", "stats"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:5000", "type": "string" },
    { "key": "ACCESS_TOKEN", "value": "YOUR_JWT_ACCESS_TOKEN_HERE", "type": "string" }
  ]
