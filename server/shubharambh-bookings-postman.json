            "url": { "raw": "{{BASE_URL}}/api/payments/PAY-2026-0001/verify", "host": ["{{BASE_URL}}"], "path": ["api", "payments", "PAY-2026-0001", "verify"] }
          }
        },
        {
          "name": "Get Payments by Booking ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": { "raw": "{{BASE_URL}}/api/payments/booking/SGC-BK-2026-0101", "host": ["{{BASE_URL}}"], "path": ["api", "payments", "booking", "SGC-BK-2026-0101"] }
          }
        }
      ]
    },
    {
