# Enterprise Environment Variables for Shubharambh Green City CRM Backend

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database URL - Uses SQLite by default for instant local execution or PostgreSQL when deployed
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET="CHANGE_ME_YOUR_32_CHAR_MIN_ACCESS_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_YOUR_32_CHAR_MIN_REFRESH_SECRET"
COOKIE_SECRET="CHANGE_ME_YOUR_16_CHAR_MIN_COOKIE_SECRET"

# Token Expiries
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
JWT_REMEMBER_ME_EXPIRATION="30d"

# Rate Limiting Configuration (Configurable thresholds)
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300

RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_BACKOFF_BASE_MS=1000

RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=100

# Security & Lockout Parameters
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
BCRYPT_SALT_ROUNDS=12

# Real SMS Gateway Configuration (Fast2SMS for India / Twilio)
SMS_PROVIDER="FAST2SMS"
SMS_API_KEY="PASTE_YOUR_FAST2SMS_API_KEY_HERE"

# Real SMTP Email Configuration (Gmail / SendGrid / Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="security@shubharambh.com"
SMTP_PASS="PASTE_YOUR_GMAIL_16_DIGIT_APP_PASSWORD_HERE"
SMTP_FROM="Shubharambh CRM Security <security@shubharambh.com>"
