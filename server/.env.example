# Server Environment Configuration Template
NODE_ENV=production
PORT=5000
DATABASE_URL="file:./dev.db" # or "postgresql://user:password@localhost:5432/shubharambh_db"
REDIS_URL="redis://localhost:6379"

# Security Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET="prod_access_secret_super_secure_32bytes_min_length"
JWT_REFRESH_SECRET="prod_refresh_secret_super_secure_32bytes_min_length"
JWT_COOKIE_SECRET="prod_cookie_secret_super_secure_32bytes_min_length"

# CORS & Frontend Origins
CORS_ORIGIN="http://localhost:5173,http://localhost"
