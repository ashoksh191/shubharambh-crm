# Enterprise Environment Variables for Shubharambh Green City CRM Backend

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database URL - Uses SQLite by default for instant local execution or PostgreSQL when deployed
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="sgc_access_secret_super_secure_key_2026_enterprise_x89a"
JWT_REFRESH_SECRET="sgc_refresh_secret_super_secure_key_2026_enterprise_y77b"
COOKIE_SECRET="sgc_cookie_secret_99812_shubharambh"

# Token Expiries
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
JWT_REMEMBER_ME_EXPIRATION="30d"

# Security & Rate Limiting Settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
BCRYPT_SALT_ROUNDS=12

# Real SMS Gateway Configuration (Fast2SMS for India / Twilio)
SMS_PROVIDER="FAST2SMS"
SMS_API_KEY="PASTE_YOUR_FAST2SMS_API_KEY_HERE"

# Real SMTP Email Configuration (Gmail / SendGrid / Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="security@shubharambh.com"
SMTP_PASS="PASTE_YOUR_GMAIL_16_DIGIT_APP_PASSWORD_HERE"
SMTP_FROM="Shubharambh CRM Security <security@shubharambh.com>"
